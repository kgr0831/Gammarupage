# Copy to .env.funding locally. Never commit actual credentials.
# Vercel reports administrator password: at least 8 characters.
FUNDING_ADMIN_TOKEN=
# Shared website: administrator ID + the password above.
FUNDING_ADMIN_USERNAME=admin
# Separate credential for dots' publish-only browser session (at least 32 random chars).
FUNDING_PUBLISHER_TOKEN=
# Existing Vercel site. Create/connect a PRIVATE Blob store; never NEXT_PUBLIC_ this token.
REPORTS_SITE_URL=https://gammarupage.vercel.app
BLOB_READ_WRITE_TOKEN=
FUNDING_ORIGIN=http://127.0.0.1:4310
FUNDING_HOST=127.0.0.1
FUNDING_PORT=4310
FUNDING_DATA_DIR=./funding/data
GAMMARU_INFO_PATH=./gammaruInfo.md
# Enable only after one real research run and notification test.
FUNDING_SCHEDULE_ENABLED=false
FUNDING_HOUR_KST=9
# Dedicated Codex login on the machine that runs the service. Do not copy auth.json.
FUNDING_CODEX_HOME=
# Linux: absolute path to codex; Windows: absolute path to native codex.exe, not codex.cmd.
FUNDING_CODEX_BIN=codex
# Empty uses the CLI default available to the signed-in account (user config is not loaded).
FUNDING_CODEX_MODEL=
# FactChat fallback: choose an account-enabled OpenAI model supporting web_search + JSON schema.
FACTCHAT_API_KEY=
# BAZE_API_KEY is also accepted; keep one key, do not put secrets in dots prompts.
BAZE_API_KEY=
FACTCHAT_MODEL=
# Vercel reports: channel ID takes priority over daily DMs. No webhook needed.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_DM_ENABLED=false
# Text/announcement channel for the daily report summary and link.
DISCORD_REPORT_CHANNEL_ID=
# dots runs daily in its cloud browser. Optional server-side fallback if no report by this hour.
FUNDING_FALLBACK_ENABLED=false
FUNDING_FALLBACK_HOUR_KST=10
DISCORD_WEBHOOK_URL=
# Optional approved email sending. Requires your own verified sending domain.
RESEND_API_KEY=
FUNDING_EMAIL_FROM=
