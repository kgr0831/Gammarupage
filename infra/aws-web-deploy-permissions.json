{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["cloudformation:CreateStack", "cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents", "cloudformation:DescribeStackResources", "cloudformation:GetTemplate"],
      "Resource": "arn:aws:cloudformation:ap-northeast-2:066523631431:stack/gammaru-web/*"
    },
    {"Effect": "Allow", "Action": "cloudformation:ValidateTemplate", "Resource": "*"},
    {
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "ec2:DescribeImages", "ec2:DescribeSubnets", "ec2:DescribeVpcs", "ec2:DescribeSecurityGroups", "ec2:DescribeNetworkInterfaces", "ec2:DescribeManagedPrefixLists", "ec2:DescribeInternetGateways", "ec2:DescribeTags", "ec2:DescribeVolumes", "ec2:DescribeInstanceAttribute"],
      "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-northeast-2"}}
    },
    {
      "Effect": "Allow", "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:instance/*",
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "gammaru-web", "ec2:InstanceType": "t4g.small"}}
    },
    {
      "Effect": "Allow", "Action": ["ec2:RunInstances", "ec2:CreateSecurityGroup"],
      "Resource": ["arn:aws:ec2:ap-northeast-2:066523631431:volume/*", "arn:aws:ec2:ap-northeast-2:066523631431:security-group/*"],
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "gammaru-web"}}
    },
    {
      "Effect": "Allow", "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:ap-northeast-2::image/*", "arn:aws:ec2:ap-northeast-2:066523631431:subnet/subnet-0bb38fc5a79ad0c47", "arn:aws:ec2:ap-northeast-2:066523631431:network-interface/*"]
    },
    {"Effect": "Allow", "Action": "ec2:CreateSecurityGroup", "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:vpc/vpc-009dcb19c3a1e036c"},
    {
      "Effect": "Allow", "Action": ["ec2:RunInstances", "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress", "ec2:DeleteSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:security-group/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "gammaru-web"}}
    },
    {
      "Effect": "Allow", "Action": ["ec2:TerminateInstances", "ec2:StopInstances", "ec2:StartInstances"],
      "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "gammaru-web"}}
    },
    {
      "Effect": "Allow", "Action": "ec2:CreateTags", "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:*/*",
      "Condition": {"StringEquals": {"ec2:CreateAction": ["RunInstances", "CreateSecurityGroup"]}}
    },
    {
      "Effect": "Allow", "Action": ["iam:CreateRole", "iam:GetRole", "iam:DeleteRole", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:DeleteRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole", "iam:TagRole", "iam:UntagRole"],
      "Resource": "arn:aws:iam::066523631431:role/gammaru-web-runtime"
    },
    {
      "Effect": "Allow", "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"], "Resource": "arn:aws:iam::066523631431:role/gammaru-web-runtime",
      "Condition": {"ArnEquals": {"iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"}}
    },
    {
      "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::066523631431:role/gammaru-web-runtime",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Effect": "Allow", "Action": ["iam:CreateInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:DeleteInstanceProfile", "iam:TagInstanceProfile"],
      "Resource": "arn:aws:iam::066523631431:instance-profile/gammaru-web-runtime"
    },
    {
      "Effect": "Allow", "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::066523631431:role/aws-service-role/vpcorigin.cloudfront.amazonaws.com/AWSServiceRoleForCloudFrontVPCOrigin",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "vpcorigin.cloudfront.amazonaws.com"}}
    },
    {
      "Effect": "Allow", "Action": ["cloudfront:CreateDistribution", "cloudfront:CreateDistributionWithTags", "cloudfront:CreateVpcOrigin"], "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "gammaru-web"}}
    },
    {
      "Effect": "Allow", "Action": ["cloudfront:GetDistribution", "cloudfront:GetDistributionConfig", "cloudfront:UpdateDistribution", "cloudfront:DeleteDistribution", "cloudfront:GetVpcOrigin", "cloudfront:DeleteVpcOrigin", "cloudfront:ListTagsForResource"],
      "Resource": ["arn:aws:cloudfront::066523631431:distribution/*", "arn:aws:cloudfront::066523631431:vpcorigin/*"],
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "gammaru-web"}}
    },
    {
      "Effect": "Allow", "Action": "cloudfront:TagResource",
      "Resource": ["arn:aws:cloudfront::066523631431:distribution/*", "arn:aws:cloudfront::066523631431:vpcorigin/*"],
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "gammaru-web"}}
    },
    {"Effect": "Allow", "Action": ["cloudfront:ListDistributions", "cloudfront:ListVpcOrigins", "ssm:GetCommandInvocation", "ssm:DescribeInstanceInformation"], "Resource": "*"},
    {
      "Effect": "Allow", "Action": ["ssm:PutParameter", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:ap-northeast-2:066523631431:parameter/gammaru/web/runtime"
    },
    {"Effect": "Allow", "Action": "ssm:GetParameter", "Resource": "arn:aws:ssm:ap-northeast-2::parameter/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"},
    {"Effect": "Allow", "Action": "ssm:SendCommand", "Resource": "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript"},
    {
      "Effect": "Allow", "Action": "ssm:SendCommand", "Resource": "arn:aws:ec2:ap-northeast-2:066523631431:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Project": "gammaru-web"}}
    }
  ]
}
